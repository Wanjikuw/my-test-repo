# Supabase — API only (server-side). Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Supabase — web. Next.js only inlines NEXT_PUBLIC_* vars into the client bundle,
# so the un-prefixed names above are invisible to browser code by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Upstash Redis (BullMQ - OCR job queue only)
REDIS_URL=

# Sentry
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# API
NODE_ENV=development
PORT=3001
# Comma-separated allowlist of browser origins permitted to call the API.
CORS_ORIGIN=http://localhost:3000

# Web -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001
