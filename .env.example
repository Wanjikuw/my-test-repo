# Supabase — API only (server-side). Never expose the service role key to the browser.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
DATABASE_URL=

# Supabase — web. Next.js only inlines NEXT_PUBLIC_* vars into the client bundle,
# so the un-prefixed names above are invisible to browser code by design.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Qwen — API only. Leave QWEN_API_KEY empty and remote OCR and model notes are simply off.
# Any OpenAI-compatible host serving Qwen works: Alibaba Cloud Model Studio (the default,
# with a free quota for new accounts), or OpenRouter's free models with
# QWEN_BASE_URL=https://openrouter.ai/api/v1 and its model names. Never NEXT_PUBLIC_.
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope-intl.aliyuncs.com/compatible-mode/v1
QWEN_TEXT_MODEL=qwen-plus
QWEN_OCR_MODEL=qwen-vl-ocr-latest
QWEN_TIMEOUT_MS=30000

# Sentry — error reporting is skipped entirely when SENTRY_DSN is empty, so local
# development stays offline. Only the API is wired; the web app is not yet.
SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# API
NODE_ENV=development
PORT=3001
# Comma-separated allowlist of browser origins permitted to call the API. Required in
# production: the API refuses to start rather than reflect an arbitrary origin.
CORS_ORIGIN=http://localhost:3000

# Per-IP request budget. Defaults to 100 per minute when unset.
RATE_LIMIT_MAX=100
RATE_LIMIT_WINDOW=1 minute

# Set to true only when something in front of the API sets X-Forwarded-For, as Fly
# does. Enabling it without a proxy lets a caller spoof their address past the limiter.
TRUST_PROXY=false

# Postgres pool size per process. Each connection holds a Supabase backend slot.
DATABASE_POOL_MAX=5

# Web -> API base URL
NEXT_PUBLIC_API_URL=http://localhost:3001
