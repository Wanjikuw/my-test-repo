{
  "name": "@allergy-checker/api",
  "private": true,
  "type": "commonjs",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "lint": "eslint src",
    "typecheck": "tsc -p tsconfig.json",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "seed:curated": "tsx src/db/seed/seed-curated-risk-data.ts",
    "seed:prohibited": "tsx src/db/seed/seed-prohibited-substances.ts",
    "seed:skin-types": "tsx src/db/seed/seed-skin-type-sensitivity.ts",
    "seed:identity": "tsx src/db/seed/seed-identity-baseline.ts",
    "seed:obf": "tsx src/db/seed/import-open-beauty-facts.ts"
  },
  "dependencies": {
    "@allergy-checker/shared": "workspace:*",
    "@fastify/cors": "^10.0.0",
    "@fastify/rate-limit": "^11.2.0",
    "@sentry/node": "^10.74.0",
    "dotenv": "^16.4.5",
    "drizzle-orm": "0.45.4",
    "fastify": "^5.12.8",
    "postgres": "3.4.4",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "drizzle-kit": "0.31.11",
    "tsx": "^4.23.15",
    "typescript": "^5.5.0",
    "vite": "^7.3.7",
    "vitest": "^4.1.12"
  }
}
